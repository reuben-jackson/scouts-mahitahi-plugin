{
  "manifest_version": 3,
  "name": "Mahi Tahi Helper",
  "version": "__VERSION__",
  "description": "Adds navigation, event, sorting, filtering, CSV export and style improvements to Mahi Tahi.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "content_scripts": [
    {
      "matches": ["https://mahitahi.scouts.nz/*"],
      "js": ["page-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://mahitahi.scouts.nz/*"],
      "css": ["styles.css"],
      "js": ["content.js", "invoice-export.js", "invoice-ui.js"],
      "run_at": "document_idle"
    }
  ]
  ,"browser_specific_settings": {
    "gecko": {
      "id": "mahitahi-helper@scouts-mahitahi-plugin",
      "strict_min_version": "128.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  }
}
